{
    "name": "hankchen/php-canvas-next",
    "description": "next generation of php-canvas: layer tree (pure structure) + pluggable renderers (image now, pdf later)",
    "type": "library",
    "license": "MIT",
    "keywords": ["canvas", "layer", "qr-code", "rendering", "layout"],
    "homepage": "https://github.com/HankChenCH/php-canvas-next",
    "autoload": {
        "psr-4": {
            "HankChen\\CanvasNext\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HankChen\\CanvasNext\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-clover=coverage.xml --coverage-text",
        "check-coverage": "@php scripts/check-coverage.php"
    },
    "authors": [
        {
            "name": "HankChen"
        }
    ],
    "require": {
        "php": "^8.3",
        "endroid/qr-code": "^6.0"
    },
    "suggest": {
        "hankchen/php-canvas-image-renderer": "位图渲染后端（intervention/image v4），输出 ImageInterface",
        "ext-intl": "可选：图素簇（grapheme）精确切分，缺失时降级为码点切分"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    }
}
