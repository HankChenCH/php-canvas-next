{
    "name": "hankchen/php-canvas-next",
    "description": "next generation of php-canvas: layer tree (pure structure) + pluggable renderers (image now, pdf later)",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "HankChen\\CanvasNext\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HankChen\\CanvasNext\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-clover=coverage.xml --coverage-text",
        "check-coverage": "@php scripts/check-coverage.php"
    },
    "authors": [
        {
            "name": "HankChen"
        }
    ],
    "require": {
        "php": "^8.3",
        "endroid/qr-code": "^6.0",
        "intervention/image": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    }
}
